import java.util.*;
class Example {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] lst = new int[n];
        for(int i = 0;i<n;i++){
            lst[i]=sc.nextInt();
        }
        
        int k = sc.nextInt();
        //System.out.print(str);
        //int[] lst = str.split(" ");
        Arrays.sort(lst);
        if(k<=n&&k>=0) System.out.print(lst[k-1]);
        else System.out.print("Ошибка ввода");
    }
}

