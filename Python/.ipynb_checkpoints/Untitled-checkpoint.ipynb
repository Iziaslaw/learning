    "import tkinter as tk\n",
    "\n",
    "root = tk.Tk()\n",
    "root.title(\"Приложение с иконкой\")\n",
    "root.geometry(\"300x200\")\n",
    "\n",
    "# Установка иконки из файла .png\n",
    "icon = tk.PhotoImage(file=\"images/logo.png\")\n",
    "root.iconphoto(False, icon)\n",
    "\n",
    "root.mainloop()"
